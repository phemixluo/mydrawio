        <mxCell id="d6D4l6lIisd65yfLRVE4-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="&lt;p&gt;嵌套留一交叉验证&lt;br&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;14个样本，14轮，每轮留一个做测试集，折内做4折交叉验证&lt;/font&gt;&lt;/p&gt;" vertex="1">
